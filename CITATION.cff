  - CC-BY-4.0
repository-code: "https://github.com/ultradeeprange/udeep"
url: "https://ultradeeprange.github.io/udeep/"
keywords:
  - high dynamic range
  - HDR
  - scientific visualization
  - gain map
  - ISO 21496-1
  - perceptual quantizer
  - data visualization standard
